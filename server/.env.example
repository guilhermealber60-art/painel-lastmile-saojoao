# Copie para .env (ou defina como env vars reais no processo/systemd/pm2) e preencha.

# Conexão com o Postgres do servidor — use a mesma instância do SaaS,
# apontando pro banco onde o schema lastmile_dashboard vai ser criado.
DATABASE_URL=postgres://usuario:senha@localhost:5432/nome_do_banco

# Token exigido no header "Authorization: Bearer <token>" pros endpoints
# POST /data/... (publicação). Gere algo aleatório e longo, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_PUBLISH_TOKEN=

# Porta do serviço.
PORT=4000

# Origem permitida pro CORS — coloque a URL de onde o index.html é servido
# (ex.: https://dash.seudominio.interno). "*" funciona mas é mais permissivo
# do que o necessário.
DASHBOARD_ALLOWED_ORIGIN=*

# Prefixo de caminho onde a API responde (precisa bater com a constante
# API_BASE no index.html). Só mude se o reverse proxy do servidor já cortar
# esse prefixo antes de encaminhar pro Node — nesse caso, use '' aqui e ''
# em API_BASE.
DASHBOARD_API_PREFIX=/lastmile-api
